rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Spark Social Storage Rules
    // Organized per user UID: users/{uid}/...

    match /users/{userId} {
      // Profile avatar and cover photos
      match /profile/{imageType}/{fileName} {
        // Authenticated users can view profile pictures and covers
        allow read: if request.auth != null;
        // Only the profile owner can upload or update their own profile media
        allow write: if request.auth != null 
                     && request.auth.uid == userId
                     && request.resource.size <= 15 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Post photos and videos
      match /posts/{postId}/{fileName} {
        allow read: if request.auth != null;
        allow write: if request.auth != null 
                     && request.auth.uid == userId
                     && (
                       (request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024) ||
                       (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
                     );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Story photos and videos
      match /stories/{storyId}/{fileName} {
        allow read: if request.auth != null;
        allow write: if request.auth != null 
                     && request.auth.uid == userId
                     && (
                       (request.resource.contentType.matches('image/.*') && request.resource.size <= 15 * 1024 * 1024) ||
                       (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
                     );
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
