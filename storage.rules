rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User profile media: avatar & cover photos
    // Path structure: users/{userId}/profile/{fileName}
    match /users/{userId}/profile/{fileName} {
      // Authenticated users can view profile pictures and cover photos
      allow read: if request.auth != null;
      // Only the authenticated account owner can upload/update/delete their profile media
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024 // 15MB limit
                   && request.resource.contentType.matches('image/.*');
    }

    // User posts media (photos and videos)
    // Path structure: users/{userId}/posts/{postId}/{fileName}
    match /users/{userId}/posts/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024 // 50MB limit
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // User stories media
    // Path structure: users/{userId}/stories/{storyId}/{fileName}
    match /users/{userId}/stories/{storyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024 // 50MB limit
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // General user-owned directory fallback
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
